// Street graph for the traffic / pedestrian simulation (from public/data/osm/graph.json, baked from OpenStreetMap).
//  * nodes: metres (x east, z south); edges keep their full polyline (a, mid points ..., b) with cumulative lengths
//  * travel directions: dir 0 = a -> b, dir 1 = b -> a. One-way edges (o = 1) are baked so that a -> b is always the legal direction.
//  * traffic keeps LEFT (India): the lateral offset of a vehicle is to the left of its direction of travel
//  * CSR adjacency for vehicles (car edges, legal direction only) and for pedestrians (every walkable edge, both ways)
import { } from '../core/rng.js';

export const CLASS_RANK = {
  motorway: 6, trunk: 5, primary: 4, secondary: 3, tertiary: 2, unclassified: 1, residential: 1, living_street: 0, service: 0, pedestrian: 0,
  motorway_link: 5, trunk_link: 4, primary_link: 3, secondary_link: 2, tertiary_link: 1, footway: 0, path: 0, steps: 0, track: 0,
};
const BAZAAR = /baz+a?a?r|chaupar|chowk|rasta|market|gali|mandi|pol\b|pole\b/i;

export class StreetGraph {
  /** @param {{nodes:number[][], edges:object[]}} json baked graph (decimetre ints) */
  constructor(json) {
    const nn = json.nodes.length, ne = json.edges.length;
    this.nodeCount = nn;
    this.edgeCount = ne;
    this.nx = new Float32Array(nn);
    this.nz = new Float32Array(nn);
    this.signal = new Uint8Array(nn);
    for (let i = 0; i < nn; i++) { const n = json.nodes[i]; this.nx[i] = n[0] / 10; this.nz[i] = n[1] / 10; this.signal[i] = n[2] ? 1 : 0; }
    this.ea = new Int32Array(ne);
    this.eb = new Int32Array(ne);
    this.len = new Float32Array(ne);
    this.width = new Float32Array(ne);
    this.oneway = new Uint8Array(ne);
    this.car = new Uint8Array(ne);
    this.speed = new Float32Array(ne); // legal/typical speed, m/s
    this.rank = new Uint8Array(ne);
    this.bazaar = new Uint8Array(ne);
    this.name = new Array(ne);
    this.cls = new Array(ne);
    this.ptsStart = new Int32Array(ne + 1);
    let total = 0;
    for (const e of json.edges) total += 2 + (e.mid ? e.mid.length / 2 : 0);
    this.pts = new Float32Array(total * 2);
    this.cum = new Float32Array(total);
    let p = 0;
    for (let i = 0; i < ne; i++) {
      const e = json.edges[i];
      this.ea[i] = e.a; this.eb[i] = e.b;
      this.width[i] = e.w || 5;
      this.oneway[i] = e.o ? 1 : 0;
      this.car[i] = e.car ? 1 : 0;
      this.speed[i] = ((e.v || 20) * 1000) / 3600;
      this.rank[i] = CLASS_RANK[e.c] ?? 1;
      this.cls[i] = e.c;
      this.name[i] = e.n || null;
      this.bazaar[i] = e.n && BAZAAR.test(e.n) ? 1 : 0;
      this.ptsStart[i] = p;
      const put = (x, z) => { this.pts[p * 2] = x; this.pts[p * 2 + 1] = z; p++; };
      put(this.nx[e.a], this.nz[e.a]);
      if (e.mid) for (let k = 0; k < e.mid.length; k += 2) put(e.mid[k] / 10, e.mid[k + 1] / 10);
      put(this.nx[e.b], this.nz[e.b]);
      let c = 0;
      const s0 = this.ptsStart[i];
      this.cum[s0] = 0;
      for (let k = s0 + 1; k < p; k++) {
        c += Math.hypot(this.pts[k * 2] - this.pts[(k - 1) * 2], this.pts[k * 2 + 1] - this.pts[(k - 1) * 2 + 1]);
        this.cum[k] = c;
      }
      this.len[i] = Math.max(c, 0.5);
    }
    this.ptsStart[ne] = p;
    this._buildAdjacency();
    this._buildGrid();
  }

  _buildAdjacency() {
    const nn = this.nodeCount, ne = this.edgeCount;
    const vc = new Int32Array(nn + 1), pc = new Int32Array(nn + 1);
    for (let e = 0; e < ne; e++) {
      const walk = this.rank[e] < 5 || !this.car[e];
      if (this.car[e]) { vc[this.ea[e] + 1]++; if (!this.oneway[e]) vc[this.eb[e] + 1]++; }
      if (walk) { pc[this.ea[e] + 1]++; pc[this.eb[e] + 1]++; }
    }
    for (let i = 0; i < nn; i++) { vc[i + 1] += vc[i]; pc[i + 1] += pc[i]; }
    this.outStart = vc;
    this.outList = new Int32Array(vc[nn]);
    this.pedStart = pc;
    this.pedList = new Int32Array(pc[nn]);
    const vf = vc.slice(0, nn), pf = pc.slice(0, nn);
    for (let e = 0; e < ne; e++) {
      const walk = this.rank[e] < 5 || !this.car[e];
      if (this.car[e]) { this.outList[vf[this.ea[e]]++] = e * 2; if (!this.oneway[e]) this.outList[vf[this.eb[e]]++] = e * 2 + 1; }
      if (walk) { this.pedList[pf[this.ea[e]]++] = e * 2; this.pedList[pf[this.eb[e]]++] = e * 2 + 1; }
    }
  }

  /** uniform grid of sample points along every edge (for "which edges are near here" queries) */
  _buildGrid(cell = 250) {
    this.cell = cell;
    const map = new Map();
    const key = (i, j) => i * 100003 + j;
    for (let e = 0; e < this.edgeCount; e++) {
      const n = Math.max(1, Math.ceil(this.len[e] / 100));
      let last = null;
      for (let k = 0; k <= n; k++) {
        this.pointAt(e, (this.len[e] * k) / n, _tmp);
        const ci = Math.floor(_tmp.x / cell), cj = Math.floor(_tmp.z / cell), kk = key(ci, cj);
        if (kk === last) continue;
        last = kk;
        let a = map.get(kk);
        if (!a) map.set(kk, (a = []));
        if (a[a.length - 1] !== e) a.push(e);
      }
    }
    this.grid = map;
    this._key = key;
  }

  /** ids of the edges with a sample point within `r` of (x, z) (deduplicated, unordered) */
  edgesNear(x, z, r, out = []) {
    out.length = 0;
    const c = this.cell, seen = this._seen || (this._seen = new Set());
    seen.clear();
    const i0 = Math.floor((x - r) / c), i1 = Math.floor((x + r) / c), j0 = Math.floor((z - r) / c), j1 = Math.floor((z + r) / c);
    for (let i = i0; i <= i1; i++) for (let j = j0; j <= j1; j++) {
      const a = this.grid.get(this._key(i, j));
      if (!a) continue;
      for (const e of a) if (!seen.has(e)) { seen.add(e); out.push(e); }
    }
    return out;
  }

  /** position along edge `e` at distance s from node a (polyline aware); writes {x, z, dx, dz} (unit tangent in the a->b direction) */
  pointAt(e, s, out) {
    const s0 = this.ptsStart[e], s1 = this.ptsStart[e + 1] - 1;
    if (s <= 0) s = 0;
    let k = s0;
    while (k < s1 - 1 && this.cum[k + 1] < s) k++;
    const c0 = this.cum[k], c1 = this.cum[k + 1];
    const t = c1 > c0 ? Math.min(1, Math.max(0, (s - c0) / (c1 - c0))) : 0;
    const x0 = this.pts[k * 2], z0 = this.pts[k * 2 + 1], x1 = this.pts[(k + 1) * 2], z1 = this.pts[(k + 1) * 2 + 1];
    out.x = x0 + (x1 - x0) * t;
    out.z = z0 + (z1 - z0) * t;
    const l = Math.hypot(x1 - x0, z1 - z0) || 1;
    out.dx = (x1 - x0) / l;
    out.dz = (z1 - z0) / l;
    return out;
  }

  /**
   * world position + heading of an agent on edge `e` travelling in direction `dir` (0 a->b, 1 b->a), `s` metres from the START of its travel,
   * with lateral offset `lat` to the LEFT of its heading (metres). Writes {x, z, dx, dz} with (dx, dz) the unit heading of travel.
   */
  place(e, dir, s, lat, out) {
    const len = this.len[e];
    this.pointAt(e, dir === 0 ? s : len - s, out);
    if (dir === 1) { out.dx = -out.dx; out.dz = -out.dz; }
    // left of heading (dx, dz) in x-east / z-south coordinates is (dz, -dx)
    out.x += out.dz * lat;
    out.z -= out.dx * lat;
    return out;
  }

  /** node reached at the end of travel on (edge, dir) and the node at its start */
  endNode(e, dir) { return dir === 0 ? this.eb[e] : this.ea[e]; }
  startNode(e, dir) { return dir === 0 ? this.ea[e] : this.eb[e]; }

  /** unit heading at the start / end of travel along (edge, dir) */
  headingAt(e, dir, atEnd, out) {
    const len = this.len[e];
    const s = dir === 0 ? (atEnd ? len : 0) : (atEnd ? 0 : len);
    this.pointAt(e, Math.min(len - 0.01, Math.max(0.01, s)), out);
    if (dir === 1) { out.dx = -out.dx; out.dz = -out.dz; }
    return out;
  }
}
const _tmp = { x: 0, z: 0, dx: 0, dz: 0 };
